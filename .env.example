# Environment Variables Template
# Copy this file to .env and fill in your actual credentials

# OpenAI API (optional, can use free g4f instead)
OPENAI_API_KEY=your_openai_api_key_here

# Twitter/X API Credentials
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Reddit API Credentials
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AI-Cash-System-Bot/1.0

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Gumroad (optional for automated price updates)
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token

# Stability AI (optional for image generation)
STABILITY_AI_KEY=your_stability_ai_key

# System Configuration
CHALLENGE_START_TIME=2026-01-05T15:00:00
TARGET_REVENUE=5000
